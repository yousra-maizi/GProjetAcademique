<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ps.eheio.gestionprojetacademique.controller.DashboardController1"
        styleClass="dash-root"
        prefWidth="1100" prefHeight="700"
        stylesheets="@../styles/dashboard.css">

    <left>
        <VBox styleClass="sidebar" spacing="4">
            <padding><Insets top="20" bottom="20" left="12" right="12"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding><Insets bottom="24"/></padding>
                <Label text="E" styleClass="sidebar-brand-box, sidebar-brand-letter"/>
                <VBox spacing="2">
                    <Label text="EHEI Oujda" styleClass="sidebar-title"/>
                    <Label text="GESTION DE PROJETS" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>
            <Button fx:id="btnOverview" text="🏠  Accueil"
                    styleClass="nav-btn, nav-active"
                    maxWidth="Infinity" onAction="#showOverview"/>
            <Button fx:id="btnGroupes" text="👥  Groupes"
                    styleClass="nav-btn"
                    maxWidth="Infinity" onAction="#showProjetTypes"/>
            <Button fx:id="btnArchive" text="📂  Archive"
                    styleClass="nav-btn"
                    maxWidth="Infinity" onAction="#showArchive"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="sidebar-sep"/>
            <VBox spacing="2" styleClass="sidebar-user">
                <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-name"/>
                <Label fx:id="adminRoleLabel" text="ADMINISTRATEUR" styleClass="admin-role"/>
            </VBox>
            <Region prefHeight="8"/>
            <Button text="⏻  Déconnexion" styleClass="btn-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-area">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="16" bottom="16" left="28" right="28"/></padding>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" text="Accueil" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle"
                           text="Bienvenue dans l'espace administration."
                           styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="badgeAnnee" text="🟢 2026 (active)"
                       styleClass="badge-annee-active"/>
                <Label fx:id="dateLabel" text="" styleClass="date-label"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS" styleClass="content-stack">
                <padding><Insets top="0" bottom="24" left="28" right="28"/></padding>

                <fx:include fx:id="overview"
                            source="panels/OverviewPanel.fxml"/>
                <fx:include fx:id="projetTypes"
                            source="panels/ProjetTypesPanel.fxml"/>
                <fx:include fx:id="niveaux"
                            source="panels/NiveauxPanel.fxml"/>
                <fx:include fx:id="groupes"
                            source="panels/GroupesPanel.fxml"/>
                <fx:include fx:id="membres"
                            source="panels/MembresPanel.fxml"/>
                <fx:include fx:id="archive"
                            source="panels/ArchivePanel.fxml"/>

            </StackPane>
        </VBox>
    </center>
</BorderPane>