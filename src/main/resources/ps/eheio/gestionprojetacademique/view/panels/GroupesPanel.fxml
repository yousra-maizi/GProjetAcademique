<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="groupesPanel"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ps.eheio.gestionprojetacademique.controller.panels.GroupesController"
      spacing="16" visible="false">
    <padding><Insets top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Retour" styleClass="btn-secondary" onAction="#retour"/>
        <Label fx:id="groupesTitre" text="Groupes" styleClass="panel-heading"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="groupSearch"
                   promptText="🔍  Rechercher un groupe..."
                   styleClass="search-field" HBox.hgrow="ALWAYS"/>
    </HBox>

    <TableView fx:id="groupesTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="grpColNom"     text="Groupe"/>
            <TableColumn fx:id="grpColProjet"  text="Projet"/>
            <TableColumn fx:id="grpColActions" text="Actions"/>
        </columns>
    </TableView>
</VBox>