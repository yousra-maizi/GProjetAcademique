<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="archivePanel"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ps.eheio.gestionprojetacademique.controller.panels.ArchiveController"
      spacing="16" visible="false">
    <padding><Insets top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Archives Universitaires" styleClass="panel-heading"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <TableView fx:id="archiveTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="archColAnnee"   text="Année Universitaire"/>
            <TableColumn fx:id="archColStatus"  text="Statut"/>
            <TableColumn fx:id="archColActions" text="Actions"/>
        </columns>
    </TableView>
</VBox>