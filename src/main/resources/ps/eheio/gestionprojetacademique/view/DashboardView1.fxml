<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="ps.eheio.gestionprojetacademique.controller.DashboardController"
    styleClass="dash-root"
    prefWidth="1100" prefHeight="700"
    stylesheets="@../styles/dashboard.css">

    <!-- ── LEFT SIDEBAR ── -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <padding><Insets top="32" bottom="32" left="16" right="16"/></padding>

            <!-- App Brand -->
            <VBox styleClass="sidebar-brand" spacing="2">
                <padding><Insets bottom="32"/></padding>
                <Label text="🎓" styleClass="sidebar-icon"/>
                <Label text="AcadAdmin" styleClass="sidebar-name"/>
                <Label text="Management Portal" styleClass="sidebar-tagline"/>
            </VBox>

            <!-- Nav Items -->
            <Label text="NAVIGATION" styleClass="nav-section-label"/>
            <Region prefHeight="8"/>

            <Button fx:id="btnOverview"   text="⬛  Overview"    styleClass="nav-btn, nav-active"  maxWidth="Infinity" onAction="#showOverview"/>
            <Button fx:id="btnProfessors" text="👨‍🏫  Professors"  styleClass="nav-btn"              maxWidth="Infinity" onAction="#showProfessors"/>
            <Button fx:id="btnStudents"   text="🎓  Students"    styleClass="nav-btn"              maxWidth="Infinity" onAction="#showStudents"/>
            <Button fx:id="btnArchive"    text="🗂️  Archive"     styleClass="nav-btn"              maxWidth="Infinity" onAction="#showArchive"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom: logged admin info + logout -->
            <Separator styleClass="sidebar-sep"/>
            <VBox spacing="4" styleClass="sidebar-user">
                <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-name"/>
                <Label fx:id="adminRoleLabel" text="Administrator" styleClass="admin-role"/>
            </VBox>
            <Button text="⏻  Logout" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ── MAIN CONTENT ── -->
    <center>
        <VBox styleClass="main-area">

            <!-- Top Bar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="20" bottom="20" left="32" right="32"/></padding>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle"    text="Overview"           styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" text="Welcome back! Here's what's happening." styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="dateLabel" text="" styleClass="date-label"/>
            </HBox>

            <!-- Dynamic Content Area -->
            <StackPane VBox.vgrow="ALWAYS" styleClass="content-stack">
                <padding><Insets top="0" bottom="24" left="32" right="32"/></padding>

                <!-- ══ OVERVIEW PANEL ══ -->
                <VBox fx:id="overviewPanel" spacing="24" visible="true">

                    <!-- Stat Cards Row -->
                    <HBox spacing="16">
                        <!-- Card 1 -->
                        <VBox styleClass="stat-card card-blue" HBox.hgrow="ALWAYS" spacing="6">
                            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
                            <Label text="PROFESSORS" styleClass="card-label"/>
                            <Label fx:id="statProfessors" text="—" styleClass="card-value"/>
                            <Label text="Active faculty members" styleClass="card-sub"/>
                        </VBox>
                        <!-- Card 2 -->
                        <VBox styleClass="stat-card card-green" HBox.hgrow="ALWAYS" spacing="6">
                            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
                            <Label text="STUDENTS" styleClass="card-label"/>
                            <Label fx:id="statStudents" text="—" styleClass="card-value"/>
                            <Label text="Enrolled students" styleClass="card-sub"/>
                        </VBox>
                        <!-- Card 3 -->
                        <VBox styleClass="stat-card card-orange" HBox.hgrow="ALWAYS" spacing="6">
                            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
                            <Label text="PROJECTS" styleClass="card-label"/>
                            <Label fx:id="statProjects" text="—" styleClass="card-value"/>
                            <Label text="Active projects" styleClass="card-sub"/>
                        </VBox>
                        <!-- Card 4 -->
                        <VBox styleClass="stat-card card-purple" HBox.hgrow="ALWAYS" spacing="6">
                            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
                            <Label text="ARCHIVED" styleClass="card-label"/>
                            <Label fx:id="statArchived" text="—" styleClass="card-value"/>
                            <Label text="Archived records" styleClass="card-sub"/>
                        </VBox>
                    </HBox>

                    <!-- Recent Activity -->
                    <VBox styleClass="panel-box" spacing="12" VBox.vgrow="ALWAYS">
                        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
                        <Label text="Recent Activity" styleClass="panel-title"/>
                        <Separator/>
                        <ListView fx:id="activityList" styleClass="activity-list" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <!-- ══ PROFESSORS PANEL ══ -->
                <VBox fx:id="professorsPanel" spacing="16" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Faculty Management" styleClass="panel-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="＋  Add Professor" styleClass="btn-primary" onAction="#addProfessor"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="profSearch" promptText="🔍  Search professors..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="profFilter" promptText="Filter by department" styleClass="combo-filter"/>
                    </HBox>
                    <TableView fx:id="professorsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="profColId"         text="ID"         prefWidth="60"/>
                            <TableColumn fx:id="profColNom"        text="Last Name"  prefWidth="160"/>
                            <TableColumn fx:id="profColPrenom"     text="First Name" prefWidth="160"/>
                            <TableColumn fx:id="profColEmail"      text="Email"      prefWidth="220"/>
                            <TableColumn fx:id="profColSpecialite" text="Speciality" prefWidth="160"/>
                            <TableColumn fx:id="profColActions"    text="Actions"    prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- ══ STUDENTS PANEL ══ -->
                <VBox fx:id="studentsPanel" spacing="16" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Student Management" styleClass="panel-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="＋  Add Student" styleClass="btn-primary" onAction="#addStudent"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="studSearch" promptText="🔍  Search students..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="studFilter" promptText="Filter by level" styleClass="combo-filter"/>
                    </HBox>
                    <TableView fx:id="studentsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="studColId"       text="ID"         prefWidth="60"/>
                            <TableColumn fx:id="studColNom"      text="Last Name"  prefWidth="160"/>
                            <TableColumn fx:id="studColPrenom"   text="First Name" prefWidth="160"/>
                            <TableColumn fx:id="studColEmail"    text="Email"      prefWidth="220"/>
                            <TableColumn fx:id="studColNiveau"   text="Level"      prefWidth="100"/>
                            <TableColumn fx:id="studColActions"  text="Actions"    prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- ══ ARCHIVE PANEL ══ -->
                <VBox fx:id="archivePanel" spacing="16" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Archive Records" styleClass="panel-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⬇  Export" styleClass="btn-secondary" onAction="#exportArchive"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="archSearch" promptText="🔍  Search archive..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="archFilter" promptText="Filter by year" styleClass="combo-filter"/>
                    </HBox>
                    <TableView fx:id="archiveTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="archColId"      text="ID"          prefWidth="60"/>
                            <TableColumn fx:id="archColTitre"   text="Title"       prefWidth="220"/>
                            <TableColumn fx:id="archColType"    text="Type"        prefWidth="120"/>
                            <TableColumn fx:id="archColAnnee"   text="Year"        prefWidth="80"/>
                            <TableColumn fx:id="archColEtudiant" text="Student"    prefWidth="160"/>
                            <TableColumn fx:id="archColActions" text="Actions"     prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
